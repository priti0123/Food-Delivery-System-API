package com.food.menu.controller;

import java.util.List;

import org.springframework.beans.factory.annotation.Autowired;
import org.springframework.http.HttpStatus;
import org.springframework.http.ResponseEntity;
import org.springframework.web.bind.annotation.GetMapping;
import org.springframework.web.bind.annotation.PathVariable;
import org.springframework.web.bind.annotation.PostMapping;
import org.springframework.web.bind.annotation.RequestBody;
import org.springframework.web.bind.annotation.RequestMapping;
import org.springframework.web.bind.annotation.RestController;

import com.food.menu.dto.MenuItemDto;
import com.food.menu.entity.MenuItem;
import com.food.menu.service.IMenuItemService;

@RestController
@RequestMapping("/menu")
public class MenuController {

	@Autowired 
    private IMenuItemService menuService;


    @PostMapping("/addmenu")
    public ResponseEntity<String> addMenuItem(@RequestBody MenuItemDto menuItem){
        return new ResponseEntity<String>(menuService.addMenuItem(menuItem) , HttpStatus.OK);
    }

    @GetMapping("findBy/{id}")
    public MenuItem getMenu(@PathVariable Long id){
        return menuService.getMenuById(id);
    }
    
    @GetMapping("findAll")
    public ResponseEntity<List<MenuItem>> getAllMenu(){
        return new ResponseEntity<List<MenuItem>>(menuService.getAllMenuDetails() , HttpStatus.OK);
    }
    
    

}