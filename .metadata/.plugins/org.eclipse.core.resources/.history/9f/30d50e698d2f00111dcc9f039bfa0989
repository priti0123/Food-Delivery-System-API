import org.springframework.web.bind.annotation.PathVariable;

import com.food.order.dto.MenuItem;

@FeignClient(name = "RESTAURANT-SERVICE")
public interface RestaurantFeignClient  {

	 @GetMapping("/menu/findBy/{id}")
