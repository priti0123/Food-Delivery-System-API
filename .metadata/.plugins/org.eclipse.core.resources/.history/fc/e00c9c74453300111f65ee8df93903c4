package com.food.menu.service;

import java.util.ArrayList;
import java.util.List;

import org.springframework.beans.BeanUtils;
import org.springframework.beans.factory.annotation.Autowired;
import org.springframework.stereotype.Service;

import com.food.menu.dto.MenuItemDto;
import com.food.menu.dto.RestaurantDto;
import com.food.menu.entity.MenuItem;
import com.food.menu.entity.Restaurant;
import com.food.menu.repository.MenuItemRepository;
import com.food.menu.repository.RestaurantRepository;

@Service
public class MenuItemServiceImpl implements IMenuItemService {

	 @Autowired
	  private MenuItemRepository menuRepo;
	 @Autowired
	 private RestaurantRepository resRepo;

	    public String addMenuItem(MenuItemDto menuDto){
	    	
	    	// menu Dto too Entity
	    	MenuItem menuEntity= new MenuItem();
	    	BeanUtils.copyProperties(menuDto, menuEntity);
	    	
	    	// Restaurant Dto details from menu Dto 
	    	RestaurantDto resDto = menuDto.getRestaurantDto();
	    	
	    	// Check  Restaurant Entity existence
	    	Restaurant resEntity = resRepo.findById(resDto.getRestaurantId()).orElseThrow(()-> new IllegalArgumentException("invalid Restaurant id"));
	    	
	    	// save Restaurant Entity to  Menu Entity
	    	BeanUtils.copyProperties(resDto, resEntity);
	    	menuEntity.setRestaurant(resEntity);
	        Long idVal = menuRepo.save(menuEntity).getId();
	        return  "Menu Item Registered With id Val ::" + idVal;
	    }

		@Override
		public MenuItem getMenuById(Long id) {
			return menuRepo.findById(id).orElseThrow(() -> new IllegalArgumentException("No menu exist with this id"));
		}

		

		@Override
		public List<MenuItem> getAllMenuDetails() {
			return menuRepo.findAll();
		}
		
}
